          "after": "/* bpf_link_free is guaranteed to be called from process context */\nstatic void bpf_link_free(struct bpf_link *link)\n{\n\tconst struct bpf_link_ops *ops = link->ops;\n\tbool sleepable = false;\n\tbool tracepoint_faultable = false;\n\n\tbpf_link_free_id(link->id);\n\tif (link->prog) {\n\t\tsleepable = link->prog->sleepable;\n\t\t/* If this is a raw tracepoint link, check if the tracepoint\n\t\t * is faultable. If so, we need to use call_rcu_tasks_trace()\n\t\t * to wait for all preempted tracepoint callbacks to complete.\n\t\t */\n\t\tif (link->type == BPF_LINK_TYPE_RAW_TRACEPOINT) {\n\t\t\tstruct bpf_raw_tp_link *raw_tp =\n\t\t\t\tcontainer_of(link, struct bpf_raw_tp_link, link);\n\n\t\t\ttracepoint_faultable = tracepoint_is_faultable(raw_tp->btp->tp);\n\t\t}\n\t\t/* detach BPF program, clean up used resources */\n\t\tops->release(link);\n\t\tbpf_prog_put(link->prog);\n\t}\n\tif (ops->dealloc_deferred) {\n\t\t/* schedule BPF link deallocation; if underlying BPF program\n\t\t * is sleepable or if the tracepoint is faultable, we need to\n\t\t * first wait for RCU tasks trace sync, then go through\n\t\t * \"classic\" RCU grace period\n\t\t */\n\t\tif (sleepable || tracepoint_faultable)\n\t\t\tcall_rcu_tasks_trace(&link->rcu, bpf_link_defer_dealloc_mult_rcu_gp);\n\t\telse\n\t\t\tcall_rcu(&link->rcu, bpf_link_defer_dealloc_rcu_gp);\n\t} else if (ops->dealloc)\n\t\tops->dealloc(link);\n}\n",
